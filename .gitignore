# Build output (root-anchored; never use bare dir-name patterns — see CLAUDE.md).
/bin/
/dist/
/safe_cli

# Never commit downloaded app binaries or anything extracted from them.
*.apk
*.xapk
*.apks
*.dex
/artifacts/

# Secrets / local env.
.env
*.env
!*.env.example
*.local

# OS / editor noise.
.DS_Store

# Ephemeral workflow worktrees (isolation: worktree)
.claude/worktrees/
