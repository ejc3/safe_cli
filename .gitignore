# Build output (root-anchored; never use bare dir-name patterns — see CLAUDE.md).
/bin/
/dist/
/safe_cli

# Never commit downloaded app binaries or anything extracted from them.
*.apk
*.xapk
*.apks
*.dex
/artifacts/

# Secrets / local env.
.env
*.env
!*.env.example
*.local

# TLS capture / key-log artifacts — carry live traffic secrets and per-user session
# ids (recoverable OAuth tokens). The capture recipe (docs/PROCESS.md §5.1) writes
# these OUTSIDE the checkout; these globs are a backstop in case one lands in-tree.
*.pcap
*.pcapng
*.keylog
*.sslkeylog
k.log

# OS / editor noise.
.DS_Store

# Ephemeral workflow worktrees (isolation: worktree)
.claude/worktrees/
livelogin/
